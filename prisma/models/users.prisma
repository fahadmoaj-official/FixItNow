
model User {
  id        String      @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  services Services[]
  
   @@map("user")
}



enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}


enum UserStatus {
  ACTIVE
  BANNED
}

